Dashboard HTML =
"<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='UTF-8'/>
<meta name='viewport' content='width=device-width,initial-scale=1'/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#090c10;color:#e8edf3;font-family:'Segoe UI',system-ui,sans-serif;font-size:13px;padding:12px}
h1{font-size:16px;font-weight:700;color:#2dffb4;margin-bottom:2px;letter-spacing:-.3px}
.sub{font-size:10px;color:rgba(232,237,243,.45);letter-spacing:.06em;text-transform:uppercase}
header{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:#0f1318;border-radius:8px;margin-bottom:12px;border:1px solid rgba(255,255,255,.07)}
.hbadge{font-size:10px;padding:3px 9px;border-radius:20px;border:1px solid;letter-spacing:.06em}
.live{border-color:#2dffb4;color:#2dffb4}
.hstats{display:flex;gap:20px}
.hs-val{font-size:18px;font-weight:700;font-family:'Segoe UI Semibold',sans-serif}
.hs-lbl{font-size:10px;color:rgba(232,237,243,.4);text-transform:uppercase;letter-spacing:.06em}
.sec{margin-bottom:14px}
.sec-head{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.sec-tag{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(232,237,243,.4)}
.sec-line{flex:1;height:1px;background:rgba(255,255,255,.07)}
.grid{display:grid;gap:8px}
.g5{grid-template-columns:repeat(5,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g2{grid-template-columns:1fr 1fr}
.kpi{background:#161c24;border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:12px 14px;position:relative;overflow:hidden;transition:border-color .2s}
.kpi:hover{border-color:rgba(255,255,255,.18)}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:rgba(61,139,255,.5)}
.kpi.warn{border-color:rgba(255,184,48,.25)}.kpi.warn::before{background:#ffb830}
.kpi.danger{border-color:rgba(255,79,79,.25)}.kpi.danger::before{background:#ff4f4f}
.kpi.good{border-color:rgba(45,255,180,.2)}.kpi.good::before{background:#2dffb4}
.kpi-lbl{font-size:10px;color:rgba(232,237,243,.45);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
.kpi-val{font-size:22px;font-weight:700;color:#e8edf3;line-height:1}
.kpi.warn .kpi-val{color:#ffb830}
.kpi.danger .kpi-val{color:#ff4f4f}
.kpi.good .kpi-val{color:#2dffb4}
.kpi-sub{font-size:10px;color:rgba(232,237,243,.25);margin-top:4px}
.card{background:#161c24;border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:14px 16px}
.card-title{font-size:11px;font-weight:600;color:rgba(232,237,243,.6);margin-bottom:12px;text-transform:uppercase;letter-spacing:.07em}
.pool-bar-bg{height:10px;background:rgba(255,255,255,.06);border-radius:5px;overflow:hidden;margin:8px 0}
.pool-bar-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,#3d8bff,#2dffb4);transition:width 1.2s cubic-bezier(.16,1,.3,1)}
.pbl{display:flex;justify-content:space-between;font-size:10px;color:rgba(232,237,243,.3);margin-top:4px}
.stage-row{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.stage-lbl{width:54px;font-size:11px;color:rgba(232,237,243,.5)}
.stage-bg{flex:1;height:7px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden}
.stage-fill{height:100%;border-radius:4px;transition:width 1.1s cubic-bezier(.16,1,.3,1);width:0}
.stage-pct{width:36px;text-align:right;font-weight:700;font-size:13px}
table{width:100%;border-collapse:collapse;font-size:11px}
thead tr{background:rgba(255,255,255,.04)}
th{text-align:left;padding:8px 12px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:rgba(232,237,243,.3);font-weight:500;border-bottom:1px solid rgba(255,255,255,.07)}
td{padding:7px 12px;border-bottom:1px solid rgba(255,255,255,.04)}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,.02)}
.td-cat{font-size:10px;letter-spacing:.05em;padding:2px 7px;border-radius:4px;display:inline-block}
.td-val{font-weight:700;font-size:12px}
.warn-t{color:#ffb830}.danger-t{color:#ff4f4f}.good-t{color:#2dffb4}
.cp{background:rgba(61,139,255,.12);color:#7eb3ff}
.cd{background:rgba(255,184,48,.1);color:#ffd080}
.ci{background:rgba(61,139,255,.08);color:#8daeff}
.cl{background:rgba(255,79,79,.1);color:#ff9f9f}
.cv{background:rgba(45,255,180,.08);color:#7fffd8}
.cm{background:rgba(255,255,255,.06);color:rgba(232,237,243,.5)}
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div>
    <h1>MatRisk AI — Auto Loan Securitisation</h1>
    <div class='sub'>Key Measures Dashboard · Power BI Desktop · May 2026</div>
  </div>
  <div class='hstats'>
    <div><div class='hs-val' style='color:#2dffb4'>₹31.8Cr</div><div class='hs-lbl'>Outstanding</div></div>
    <div><div class='hs-val'>500</div><div class='hs-lbl'>Loans</div></div>
    <div><div class='hs-val' style='color:#ffb830'>15.6%</div><div class='hs-lbl'>30+ DPD</div></div>
    <div><div class='hs-val' style='color:#3d8bff'>3.67%</div><div class='hs-lbl'>ECL Coverage</div></div>
  </div>
  <span class='hbadge live'>● Live Model</span>
</header>

<!-- POOL OVERVIEW -->
<div class='sec'>
  <div class='sec-head'><span>📊</span><span class='sec-tag'>Pool Overview</span><div class='sec-line'></div></div>
  <div class='card' style='margin-bottom:8px'>
    <div style='display:flex;align-items:center;gap:20px'>
      <div><div style='font-size:28px;font-weight:700;color:#2dffb4;line-height:1'>58.2%</div><div class='kpi-sub' style='margin-top:3px'>Pool Factor Remaining</div></div>
      <div style='flex:1'>
        <div class='pool-bar-bg'><div class='pool-bar-fill' id='pb' style='width:0%'></div></div>
        <div class='pbl'><span>Amortised: 41.8% (₹22.8Cr)</span><span>Remaining: 58.2% (₹31.8Cr)</span></div>
      </div>
      <div style='display:flex;gap:24px'>
        <div><div style='font-size:17px;font-weight:700'>₹54.6Cr</div><div class='kpi-sub'>Original Pool</div></div>
        <div><div style='font-size:17px;font-weight:700'>10.95%</div><div class='kpi-sub'>Wtd Avg Rate</div></div>
        <div><div style='font-size:17px;font-weight:700'>45.1 mo</div><div class='kpi-sub'>Avg Term</div></div>
      </div>
    </div>
  </div>
  <div class='grid g5'>
    <div class='kpi good'><div class='kpi-lbl'>Outstanding Balance</div><div class='kpi-val'>₹31.8Cr</div><div class='kpi-sub'>current pool size</div></div>
    <div class='kpi'><div class='kpi-lbl'>Original Pool Balance</div><div class='kpi-val'>₹54.6Cr</div><div class='kpi-sub'>at origination</div></div>
    <div class='kpi'><div class='kpi-lbl'>Pool Factor</div><div class='kpi-val'>58.2%</div><div class='kpi-sub'>balance remaining</div></div>
    <div class='kpi'><div class='kpi-lbl'>Total Loans</div><div class='kpi-val'>500</div><div class='kpi-sub'>active accounts</div></div>
    <div class='kpi'><div class='kpi-lbl'>Wtd Avg Rate</div><div class='kpi-val'>10.95%</div><div class='kpi-sub'>portfolio yield</div></div>
  </div>
</div>

<!-- DELINQUENCY -->
<div class='sec'>
  <div class='sec-head'><span>⚠️</span><span class='sec-tag'>Delinquency</span><div class='sec-line'></div></div>
  <div class='grid g4' style='margin-bottom:10px'>
    <div class='kpi warn'><div class='kpi-lbl'>30+ DPD Rate</div><div class='kpi-val'>15.6%</div><div class='kpi-sub'>78 of 500 loans</div></div>
    <div class='kpi warn'><div class='kpi-lbl'>60+ DPD Rate</div><div class='kpi-val'>11.4%</div><div class='kpi-sub'>57 loans</div></div>
    <div class='kpi danger'><div class='kpi-lbl'>90+ DPD Rate</div><div class='kpi-val'>6.6%</div><div class='kpi-sub'>NPA proxy</div></div>
    <div class='kpi danger'><div class='kpi-lbl'>Delinquent Balance 30+</div><div class='kpi-val'>₹4.49Cr</div><div class='kpi-sub'>arrears exposure</div></div>
  </div>

  <!-- SVG DPD Chart -->
  <div class='card'>
    <div class='card-title'>Delinquency Bucket — Rate %</div>
    <svg viewBox='0 0 480 120' width='100%' style='overflow:visible'>
      <!-- Grid lines -->
      <line x1='60' y1='10' x2='460' y2='10' stroke='rgba(255,255,255,.06)' stroke-width='1'/>
      <line x1='60' y1='35' x2='460' y2='35' stroke='rgba(255,255,255,.06)' stroke-width='1'/>
      <line x1='60' y1='60' x2='460' y2='60' stroke='rgba(255,255,255,.06)' stroke-width='1'/>
      <line x1='60' y1='85' x2='460' y2='85' stroke='rgba(255,255,255,.06)' stroke-width='1'/>
      <!-- Y labels -->
      <text x='54' y='14' text-anchor='end' fill='rgba(232,237,243,.3)' font-size='9'>20%</text>
      <text x='54' y='39' text-anchor='end' fill='rgba(232,237,243,.3)' font-size='9'>15%</text>
      <text x='54' y='64' text-anchor='end' fill='rgba(232,237,243,.3)' font-size='9'>10%</text>
      <text x='54' y='89' text-anchor='end' fill='rgba(232,237,243,.3)' font-size='9'>5%</text>
      <text x='54' y='112' text-anchor='end' fill='rgba(232,237,243,.3)' font-size='9'>0%</text>
      <!-- Bars: scale 0-20% → 0-100px height, base at y=110 -->
      <!-- 30+ DPD: 15.6% → 78px -->
      <rect x='100' y='32' width='70' height='78' rx='4' fill='#ffb830' opacity='.8'/>
      <text x='135' y='26' text-anchor='middle' fill='#ffb830' font-size='11' font-weight='700'>15.6%</text>
      <text x='135' y='118' text-anchor='middle' fill='rgba(232,237,243,.45)' font-size='10'>30+ DPD</text>
      <!-- 60+ DPD: 11.4% → 57px -->
      <rect x='220' y='53' width='70' height='57' rx='4' fill='#ff7832' opacity='.8'/>
      <text x='255' y='47' text-anchor='middle' fill='#ff7832' font-size='11' font-weight='700'>11.4%</text>
      <text x='255' y='118' text-anchor='middle' fill='rgba(232,237,243,.45)' font-size='10'>60+ DPD</text>
      <!-- 90+ DPD: 6.6% → 33px -->
      <rect x='340' y='77' width='70' height='33' rx='4' fill='#ff4f4f' opacity='.8'/>
      <text x='375' y='71' text-anchor='middle' fill='#ff4f4f' font-size='11' font-weight='700'>6.6%</text>
      <text x='375' y='118' text-anchor='middle' fill='rgba(232,237,243,.45)' font-size='10'>90+ DPD</text>
      <!-- Base line -->
      <line x1='60' y1='110' x2='460' y2='110' stroke='rgba(255,255,255,.15)' stroke-width='1'/>
    </svg>
  </div>
</div>

<!-- IFRS9 -->
<div class='sec'>
  <div class='sec-head'><span>🔴</span><span class='sec-tag'>IFRS9 Credit Risk</span><div class='sec-line'></div></div>
  <div class='grid g2' style='margin-bottom:8px'>
    <div class='card'>
      <div class='card-title'>Stage Distribution</div>
      <div class='stage-row'>
        <span class='stage-lbl'>Stage 1</span>
        <div class='stage-bg'><div class='stage-fill' id='s1' style='background:#2dffb4'></div></div>
        <span class='stage-pct' style='color:#2dffb4'>84.4%</span>
      </div>
      <div class='stage-row'>
        <span class='stage-lbl'>Stage 2</span>
        <div class='stage-bg'><div class='stage-fill' id='s2' style='background:#ffb830'></div></div>
        <span class='stage-pct' style='color:#ffb830'>9.0%</span>
      </div>
      <div class='stage-row'>
        <span class='stage-lbl'>Stage 3</span>
        <div class='stage-bg'><div class='stage-fill' id='s3' style='background:#ff4f4f'></div></div>
        <span class='stage-pct' style='color:#ff4f4f'>6.6%</span>
      </div>
    </div>
    <div class='grid g2' style='align-content:start;gap:8px'>
      <div class='kpi warn'><div class='kpi-lbl'>Total ECL Provision</div><div class='kpi-val'>₹1.17Cr</div><div class='kpi-sub'>expected credit loss</div></div>
      <div class='kpi good'><div class='kpi-lbl'>ECL Coverage Ratio</div><div class='kpi-val'>3.67%</div><div class='kpi-sub'>provision / balance</div></div>
      <div class='kpi'><div class='kpi-lbl'>Wtd Avg PD</div><div class='kpi-val warn-t'>7.28%</div><div class='kpi-sub'>probability of default</div></div>
      <div class='kpi'><div class='kpi-lbl'>Wtd Avg LGD</div><div class='kpi-val danger-t'>50.24%</div><div class='kpi-sub'>loss given default</div></div>
    </div>
  </div>
</div>

<!-- LOSS & RECOVERY -->
<div class='sec'>
  <div class='sec-head'><span>💸</span><span class='sec-tag'>Loss &amp; Recovery</span><div class='sec-line'></div></div>
  <div class='grid g2'>
    <div class='card'>
      <div class='card-title'>Loss Breakdown</div>
      <!-- SVG Loss Chart -->
      <svg viewBox='0 0 300 110' width='100%'>
        <line x1='40' y1='10' x2='280' y2='10' stroke='rgba(255,255,255,.05)' stroke-width='1'/>
        <line x1='40' y1='40' x2='280' y2='40' stroke='rgba(255,255,255,.05)' stroke-width='1'/>
        <line x1='40' y1='70' x2='280' y2='70' stroke='rgba(255,255,255,.05)' stroke-width='1'/>
        <line x1='40' y1='90' x2='280' y2='90' stroke='rgba(255,255,255,.15)' stroke-width='1'/>
        <!-- Gross Loss: 12.76L → 80px -->
        <rect x='60' y='10' width='50' height='80' rx='4' fill='#ff4f4f' opacity='.75'/>
        <text x='85' y='7' text-anchor='middle' fill='#ff4f4f' font-size='9' font-weight='700'>₹12.76L</text>
        <text x='85' y='102' text-anchor='middle' fill='rgba(232,237,243,.4)' font-size='9'>Gross Loss</text>
        <!-- Recoveries: 3.97L → 25px -->
        <rect x='145' y='65' width='50' height='25' rx='4' fill='#2dffb4' opacity='.75'/>
        <text x='170' y='61' text-anchor='middle' fill='#2dffb4' font-size='9' font-weight='700'>₹3.97L</text>
        <text x='170' y='102' text-anchor='middle' fill='rgba(232,237,243,.4)' font-size='9'>Recoveries</text>
        <!-- Net Loss: 8.79L → 55px -->
        <rect x='225' y='35' width='50' height='55' rx='4' fill='#3d8bff' opacity='.75'/>
        <text x='250' y='31' text-anchor='middle' fill='#3d8bff' font-size='9' font-weight='700'>₹8.79L</text>
        <text x='250' y='102' text-anchor='middle' fill='rgba(232,237,243,.4)' font-size='9'>Net Loss</text>
      </svg>
    </div>
    <div class='grid g2' style='align-content:start;gap:8px'>
      <div class='kpi danger'><div class='kpi-lbl'>Total Gross Loss</div><div class='kpi-val'>₹12.76L</div><div class='kpi-sub'>9 defaults</div></div>
      <div class='kpi good'><div class='kpi-lbl'>Total Recoveries</div><div class='kpi-val'>₹3.97L</div><div class='kpi-sub'>31.1% recovery rate</div></div>
      <div class='kpi'><div class='kpi-lbl'>Net Loss</div><div class='kpi-val'>₹8.79L</div><div class='kpi-sub'>after recoveries</div></div>
      <div class='kpi good'><div class='kpi-lbl'>Net Loss Rate</div><div class='kpi-val'>0.16%</div><div class='kpi-sub'>of original pool</div></div>
    </div>
  </div>
</div>

<!-- LTV + PREPAYMENT -->
<div class='sec'>
  <div class='sec-head'><span>🚗</span><span class='sec-tag'>LTV &amp; Collateral · Prepayment</span><div class='sec-line'></div></div>
  <div class='grid g4'>
    <div class='kpi'><div class='kpi-lbl'>Wtd Avg Current LTV</div><div class='kpi-val'>67.5%</div><div class='kpi-sub'>strong coverage</div></div>
    <div class='kpi good'><div class='kpi-lbl'>Underwater Loans</div><div class='kpi-val'>0%</div><div class='kpi-sub'>no LTV &gt; 100%</div></div>
    <div class='kpi'><div class='kpi-lbl'>Total Prepayments</div><div class='kpi-val'>₹10.9L</div><div class='kpi-sub'>principal prepaid</div></div>
    <div class='kpi'><div class='kpi-lbl'>Prepayment Rate (SMM)</div><div class='kpi-val'>0.34%</div><div class='kpi-sub'>low prepayment speed</div></div>
  </div>
</div>

<!-- KPI SUMMARY TABLE -->
<div class='sec'>
  <div class='sec-head'><span>📋</span><span class='sec-tag'>KPI Summary — All 27 Measures</span><div class='sec-line'></div></div>
  <div style='border:1px solid rgba(255,255,255,.07);border-radius:8px;overflow:hidden'>
    <table>
      <thead><tr><th>#</th><th>Category</th><th>Metric</th><th>Formatted Value</th><th>Type</th></tr></thead>
      <tbody>
        <tr><td style='color:rgba(232,237,243,.3)'>01</td><td><span class='td-cat cp'>Pool Overview</span></td><td style='color:rgba(232,237,243,.6)'>Total Outstanding Balance</td><td class='td-val good-t'>₹31,778,520.14</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Currency</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>02</td><td><span class='td-cat cp'>Pool Overview</span></td><td style='color:rgba(232,237,243,.6)'>Total Original Pool Balance</td><td class='td-val'>₹54,607,370.00</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Currency</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>03</td><td><span class='td-cat cp'>Pool Overview</span></td><td style='color:rgba(232,237,243,.6)'>Pool Factor</td><td class='td-val'>58.19%</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Percent</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>04</td><td><span class='td-cat cp'>Pool Overview</span></td><td style='color:rgba(232,237,243,.6)'>Total Loans</td><td class='td-val'>500</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Number</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>05</td><td><span class='td-cat cp'>Pool Overview</span></td><td style='color:rgba(232,237,243,.6)'>Weighted Avg Interest Rate</td><td class='td-val'>10.95%</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Percent</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>06</td><td><span class='td-cat cp'>Pool Overview</span></td><td style='color:rgba(232,237,243,.6)'>Weighted Avg Remaining Term</td><td class='td-val'>45.1 mo</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Number</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>07</td><td><span class='td-cat cd'>Delinquency</span></td><td style='color:rgba(232,237,243,.6)'>30+ DPD Loans</td><td class='td-val warn-t'>78</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Number</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>08</td><td><span class='td-cat cd'>Delinquency</span></td><td style='color:rgba(232,237,243,.6)'>30+ DPD Rate</td><td class='td-val warn-t'>15.60%</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Percent</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>09</td><td><span class='td-cat cd'>Delinquency</span></td><td style='color:rgba(232,237,243,.6)'>60+ DPD Rate</td><td class='td-val warn-t'>11.40%</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Percent</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>10</td><td><span class='td-cat cd'>Delinquency</span></td><td style='color:rgba(232,237,243,.6)'>90+ DPD Rate</td><td class='td-val danger-t'>6.60%</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Percent</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>11</td><td><span class='td-cat cd'>Delinquency</span></td><td style='color:rgba(232,237,243,.6)'>Delinquent Balance 30+</td><td class='td-val danger-t'>₹44,852,540.49</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Currency</td></tr>
        <tr><td style='color:rgba(232,237,243,.3)'>12</td><td><span class='td-cat ci'>IFRS9 Credit Risk</span></td><td style='color:rgba(232,237,243,.6)'>Total ECL Provision</td><td class='td-val warn-t'>₹11,662,952.90</td><td style='color:rgba(232,237,243,.25);font-size:10px'>Currency</td></tr>
